{
  "name": "hlid",
  "description": "Hliðskjálf - Watcher of Worlds",
  "version": "0.1.86",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:all": "bun run --parallel --bun dev dev:server",
    "dev:preview": "bun scripts/dev-preview.ts",
    "build": "bun scripts/bundle-vault-worker.ts && vite build && bun scripts/embed-client.ts",
    "build:win": "bun run build && bun scripts/bundle-pty-assets.ts && bun scripts/bundle-whisper-assets.ts && bun scripts/build-win.ts",
    "postinstall": "bun scripts/embed-client.ts",
    "start": "bun src/server/index.ts",
    "preview": "vite preview",
    "perf:install-browser": "playwright install chromium",
    "perf:gate": "bun scripts/perf/gate.ts",
    "perf:smoke": "bun scripts/perf/gate.ts --idle-ms=10000 --label=smoke",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "bun run test:coverage:vitest && bun run test:coverage:bun && bun run coverage:merge",
    "test:coverage:vitest": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:coverage:bun": "bun ./node_modules/vitest/vitest.mjs run --config vitest.bun.config.ts --coverage",
    "coverage:merge": "bun scripts/merge-coverage.ts",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:db": "bun test src/db/ src/server/auth.bun.test.ts",
    "test:all": "bun run test && bun ./node_modules/vitest/vitest.mjs run --config vitest.bun.config.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check:biome": "biome check",
    "typecheck": "tsc --noEmit",
    "check": "bun run check:biome && bun run typecheck && bun run analyze",
    "analyze": "fallow dead-code --production --summary --fail-on-issues --changed-since origin/main && fallow health --production --coverage coverage/coverage-final.json --score --changed-since origin/main --min-score 85 && fallow --only dupes --production-dupes --summary --changed-since origin/main --dupes-threshold 0.12",
    "analyze:full": "fallow dead-code --production --summary --fail-on-issues && fallow health --production --coverage coverage/coverage-final.json --score --min-score 85 && fallow --only dupes --production-dupes --summary --dupes-threshold 0.12",
    "validate": "bun scripts/bundle-vault-worker.ts && bun run test:coverage && bun run check && bun run analyze:full",
    "stage": "biome format --write && biome lint --fix && biome check --fix && bun run validate",
    "version:bump": "bumpp --quiet --no-commit --no-tag --no-push",
    "version:patch": "bun run version:bump --release patch",
    "version:minor": "bun run version:bump --release minor",
    "version:major": "bun run version:bump --release major",
    "generate-icons": "bun scripts/generate-icons.ts",
    "repair:codex-usage": "bun scripts/repair-codex-usage.ts",
    "repair:claude-usage": "bun scripts/repair-claude-usage.ts",
    "import:provider-history": "bun scripts/import-provider-history.ts",
    "report:build-week": "bun scripts/generate-build-provenance.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.228",
    "@anthropic-ai/sdk": "^0.115.0",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "@tanstack/router-plugin": "1.168.23",
    "@umbod/core": "https://github.com/Kyle-Undefined/umbodsmadr/releases/download/0.0.12/umbod-core-0.0.12.tgz",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "es-module-lexer": "2.3.1",
    "highlight.js": "11.11.1",
    "jsonc-parser": "3.3.1",
    "katex": "0.18.1",
    "lucide-react": "1.28.0",
    "mermaid": "11.16.1",
    "node-pty": "1.1.0",
    "pngjs": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gemoji": "8.0.0",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-mark-highlight": "0.1.1",
    "remark-math": "6.0.0",
    "smol-toml": "1.7.1",
    "tailwindcss": "4.3.3",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "bumpp": "12.1.1",
    "fallow": "3.2.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "js-yaml": "5.2.3",
    "jsdom": "28.1.0",
    "playwright": "1.62.1",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.228"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "js-yaml": "5.2.3",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "@anthropic-ai/sdk": "^0.115.0",
    "dompurify": "^3.4.13",
    "@hono/node-server": "^2.0.5",
    "postcss": "8.5.23",
    "qs": "^6.15.3",
    "undici": "7.29.0",
    "@babel/core": "^7.29.7",
    "shell-quote": "^1.9.0",
    "esbuild": "^0.28.1"
  }
}
